{
  "name": "@colla/desktop",
  "version": "0.1.0",
  "description": "Desktop app for Colla using Electron",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "electron .",
    "start": "npm run build && electron .",
    "package": "electron-builder",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.colla.desktop",
    "productName": "Colla",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}